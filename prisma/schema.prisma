// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output = "./generated/client"
}

datasource db {
  provider = "sqlite"
}


model Guild {
  id           String   @id
  logs_channel String?
  addedAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
