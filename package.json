{
  "name": "discord.js-bot-structure",
  "version": "1.0.0",
  "description": "A useful discord.js-bot-structure",
  "main": "main.ts",
  "scripts": {
    "test": "tsc --noEmit",
    "compile": "tsc",
    "watch": "tsc --watch",
    "start": "tsc && node dist/shards.js",
    "entrypoint": "npx prisma migrate deploy && npx prisma generate && tsc && node dist/shards.js",
    "dev": "node dist/index.js",
    "lint": "eslint .",
    "prettier": "prettier --check **/*.ts",
    "check": "yarn lint && yarn prettier && yarn test",
    "format": "prettier --write **/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warix8/discord.js-bot-structure.git"
  },
  "author": "Warix",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/warix8/discord.js-bot-structure/issues"
  },
  "homepage": "https://github.com/warix8/discord.js-bot-structure#readme",
  "contributors": [
    "Warix",
    "Ota"
  ],
  "node": ">=16.6.0",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "asciiart-logo": "^0.2.7",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
